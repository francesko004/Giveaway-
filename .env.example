# ── Required ───────────────────────────────────────────────────────────
# Public URL of the site (used in QR codes, e-mails, cookies, metadata). No trailing slash.
APP_URL=https://giveaway.example.al
# ≥ 32 random chars. Generate: openssl rand -base64 48
SESSION_SECRET=
# Local development only (docker compose builds DATABASE_URL from the POSTGRES_* values below).
DATABASE_URL=postgresql://giveaway:change-me@localhost:5432/giveaway

# ── Docker Compose database ────────────────────────────────────────────
POSTGRES_DB=giveaway
POSTGRES_USER=giveaway
POSTGRES_PASSWORD=
# Domain for the optional Caddy reverse proxy (docker compose --profile caddy up -d)
DOMAIN=giveaway.example.al

# ── Reverse proxy / Cloudflare ─────────────────────────────────────────
# true when running behind your own proxy (reads CF-Connecting-IP / X-Forwarded-For for rate limiting)
TRUST_PROXY=true

# ── E-mail (optional — the platform works without it) ──────────────────
RESEND_API_KEY=
EMAIL_FROM="Giveaway <giveaway@example.al>"
ADMIN_NOTIFICATION_EMAIL=

# ── Bot protection (optional) — Cloudflare Turnstile ───────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Scheduler ──────────────────────────────────────────────────────────
# The app runs housekeeping every 30 s by itself. For multiple instances set DISABLE_SCHEDULER=1
# and call POST /api/cron/tick with "Authorization: Bearer $CRON_SECRET" from one cron job.
CRON_SECRET=
DISABLE_SCHEDULER=

# ── Fairness engine (optional) ─────────────────────────────────────────
# Seconds between publishing a commitment and the committed drand round (min 60).
DRAW_COMMIT_LEAD_SECONDS=120
# Comma-separated drand relays (defaults: api.drand.sh, api2, api3, drand.cloudflare.com)
DRAND_URLS=
# Uploaded images (inside the container this is a Docker volume)
UPLOAD_DIR=./storage/uploads
# Only if outbound HTTPS must go through an egress proxy: make Node's fetch honour HTTPS_PROXY.
# NODE_USE_ENV_PROXY=1
