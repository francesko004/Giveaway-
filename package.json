{
  "name": "giveaway-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "draw:verify": "tsx scripts/verify-draw.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "libphonenumber-js": "^1.13.17",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.0",
    "resend": "^6.39.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "typescript-eslint": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript-eslint/eslint-plugin": "8.73.0"
  }
}
